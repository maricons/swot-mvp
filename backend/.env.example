PORT=3000
DB_SERVER=localhost
DB_DATABASE=swot_db
DB_USER=sa
DB_PASSWORD=change-me-Strong1!
# Long random text used to sign the login tokens
JWT_SECRET=change-me-to-a-long-random-string
# Origin(s) of the frontend allowed by CORS, comma separated (Vite uses 5173 by default)
FRONTEND_URL=http://localhost:5173

# Password recovery emails. Without SMTP_HOST the message is only printed on the server console (development)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=SWOT <no-reply@example.com>
